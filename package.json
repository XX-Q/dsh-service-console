    "index.js",
    "console.html",
    "launcher.js",
    "cordis.patch.yml",
    "skills",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "task-manager",
    "task-console",
    "service-manager",
    "process-manager",
    "background-jobs",
    "windows"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
